{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lojinha-pronta",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // CSS, JS e ícones de public/_lp/ entram no Worker como texto, e as imagens da
  // apresentação (PNG) como bytes (src/estaticos.ts). Saem em /_lp/, um caminho
  // que não colide com nenhuma página de loja.
  "rules": [
    { "type": "Text", "globs": ["**/*.css", "**/*.js.txt", "**/*.svg"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lojinha-pronta",
      "database_id": "ae325290-165f-4ad1-a7ee-d364848d2ef4",
      "migrations_dir": "migrations"
    }
  ],

  // Imagens (públicas, servidas pelo Worker) e PDFs (privados, só depois do pagamento).
  "r2_buckets": [{ "binding": "ARQUIVOS", "bucket_name": "lojinha-pronta-arquivos" }],

  // Uma vez por dia: renova token do Mercado Pago, limpa sessão vencida,
  // confere assinatura pendente.
  "triggers": { "crons": ["17 6 * * *"] },

  "vars": {
    "DOMINIO_RAIZ": "lojinhapronta.com.br",
    // Endereço do painel. Trocar por https://app.lojinhapronta.com.br quando o
    // domínio estiver no Cloudflare.
    "APP_URL": "https://app.lojinhapronta.com.br",
    "SITE_URL": "https://lojinhapronta.com.br",
    "EMAIL_REMETENTE": "pedidos@lojinhapronta.com.br",
    "DIAS_TESTE": "7",
    // "nao" enquanto o domínio não usa o DNS do Cloudflare: as lojas abrem em
    // app.lojinhapronta.com.br/loja/<nome>. Virar para "sim" depois.
    "SUBDOMINIOS_ATIVOS": "sim",
    // Anti-robô (Turnstile) das telas de acesso. A chave pública fica aqui; o
    // segredo, em TURNSTILE_SECRET. Sem os dois, fica desligado.
    "TURNSTILE_SITEKEY": "0x4AAAAAAGUEP7dLhCXWzONU"
  },

  // Os subdomínios das lojas. Só funcionam depois que o domínio passar a usar o
  // DNS do Cloudflare (ver LEIA-ME, "Colocar no ar").
  "routes": [
    { "pattern": "app.lojinhapronta.com.br", "custom_domain": true },
    // A raiz só passa pelo Worker com a nuvem laranja ligada no registro A.
    { "pattern": "lojinhapronta.com.br/*", "zone_name": "lojinhapronta.com.br" },
    { "pattern": "*.lojinhapronta.com.br/*", "zone_name": "lojinhapronta.com.br" }
  ],

  "observability": { "enabled": true }
}
